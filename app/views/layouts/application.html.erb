<!DOCTYPE html>
<html>
  <%= render "layouts/head"%>
  <body>
    <%= render "layouts/header"%>
    <%#=_headerの内容をview(テンプレート)に挿入.%>
    <div class="container">
      <% flash.each do |message_type,message|%>
        <%= content_tag(:div, message, class: "alert alert-#{message_type}") %>
      <%end%>
      <%= yield %>
    </div>
    <%= render "layouts/footer"%>
    <%= debug(params) if Rails.env.development? %>
  </body>
</html>

